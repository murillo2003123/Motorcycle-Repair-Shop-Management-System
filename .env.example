# Week 11 Task 3 — Environment Configuration Example (Supabase + Vercel)
# Copy this file to .env for local overrides, or set these keys in Vercel Project Settings -> Environment Variables.
# Never commit real secrets (.env) to Git.

PORT=3000
NODE_ENV=production
APP_DEBUG=false
SHOP_NAME="Murillo, Cabatingan & Dagala Motorcycle Repair Shop"
DEFAULT_OWNER_ROLE=owner

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
